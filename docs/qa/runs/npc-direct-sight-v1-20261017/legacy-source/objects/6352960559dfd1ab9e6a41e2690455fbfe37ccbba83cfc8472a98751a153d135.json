{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zombie-harvest://schemas/event-gate-v1.json",
  "title": "Zombie Harvest EventGateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "nightAllowed", "preconditions"],
  "properties": {
    "version": { "const": 1 },
    "phase": {
      "oneOf": [
        { "enum": ["DAY", "NIGHT", "ANY"] },
        { "type": "array", "minItems": 1, "items": { "enum": ["DAY", "NIGHT", "ANY"] } }
      ]
    },
    "nightAllowed": { "type": "boolean" },
    "preconditions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "id": { "type": "string", "minLength": 1 },
              "min": { "type": ["number", "string"] },
              "max": { "type": ["number", "string"] },
              "value": { "type": "boolean" }
            },
            "oneOf": [
              { "required": ["type", "id"], "properties": { "type": { "const": "landmark_exists" }, "id": { "type": "string", "minLength": 1 } } },
              { "required": ["type", "min"], "properties": { "type": { "const": "camp_trust" }, "min": { "type": ["number", "string"] } } },
              { "required": ["type", "id"], "properties": { "type": { "const": "npc_alive" }, "id": { "type": "string", "minLength": 1 } } },
              { "required": ["type", "id"], "properties": { "type": { "const": "flag" }, "id": { "type": "string", "minLength": 1 }, "value": { "type": "boolean" } } },
              { "required": ["type", "min", "max"], "properties": { "type": { "const": "day_between" }, "min": { "type": ["number", "string"] }, "max": { "type": ["number", "string"] } } }
            ]
          }
        ]
      }
    }
  }
}
