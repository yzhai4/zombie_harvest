{
  "schemaVersion": 1,
  "id": "watchpost-manual-v1",
  "version": 1,
  "definition": {
    "id": "watchpost-003",
    "chainId": "watchpost-003",
    "definitionVersion": 1,
    "instancePolicy": "once-v1",
    "title": "岗亭人工哨报",
    "description": "让已驻守的健康守卫提供独立于中继的较弱预警准备。",
    "category": "defense",
    "phase": [
      "day_2",
      "day_8"
    ],
    "priority": 74,
    "repeatable": false,
    "optional": true,
    "gateVersion": 1,
    "evaluatePreconditions": true,
    "gate": {
      "version": 1,
      "phase": "DAY",
      "nightAllowed": false,
      "preconditions": [
        {
          "type": "landmark_exists",
          "id": "watchPost"
        }
      ]
    },
    "preconditions": [
      {
        "type": "landmark_exists",
        "id": "watchPost"
      }
    ],
    "startConditions": [
      {
        "type": "landmark_exists",
        "id": "watchPost"
      }
    ],
    "nodes": [
      {
        "nodeId": "manual_preparation",
        "title": "岗亭哨报准备",
        "text": "现有守卫可在岗亭轮班传回人工哨报。先探索并接管同一岗亭，再靠近确认；也可关闭事项、先补粮或继续中继。确认追加0物资、0分钟，不是新的安装劳动。原接管支付6体力、30分钟并占用固定守军；据点维护额外1粮/日，守军仍按原规则配给，不参加本营援防。普通人工准备只降低下一场的起始接近，弱于中继，不保证安全。",
        "choices": [
          {
            "id": "manual",
            "label": "确认低噪人工哨报",
            "hint": "追加0物资／0分钟 · 需同站健康守军、维护有效且在1.25格内 · 可暂不处理",
            "requires": [
              {
                "type": "outpost_ready",
                "id": "watchPost",
                "healthyOnly": true,
                "nearby": true
              }
            ],
            "effects": [
              {
                "op": "unlock",
                "key": "watchpost-manual-prepared"
              },
              {
                "op": "recordHistory",
                "key": "watchpost-003:manual",
                "payload": {
                  "route": "manual",
                  "outpostId": "watchPost",
                  "definitionVersion": 1
                }
              }
            ]
          }
        ]
      }
    ],
    "autonomy": {
      "resultId": "watchpost_manual_autonomous",
      "effects": [
        {
          "op": "unlock",
          "key": "watchpost-manual-prepared"
        },
        {
          "op": "recordHistory",
          "key": "watchpost-003:manual-autonomy",
          "payload": {
            "route": "autonomy:manual",
            "outpostId": "watchPost",
            "definitionVersion": 1
          }
        }
      ]
    },
    "fallback": {
      "ifMissingNpc": "ledger_only",
      "ifInsufficientPopulation": "ledger_only",
      "ifExpired": "watchpost_damaged",
      "ifSkipped": "ledger_only"
    },
    "hooks": [
      "onDayStart",
      "onOutpostSecured"
    ]
  }
}
